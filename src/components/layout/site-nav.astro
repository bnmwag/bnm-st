---
import { Container, Grid } from "@/components/core";

const links = [
    { label: "About", href: "/about" },
    { label: "Contact", href: "/contact" },
];
---

<nav data-site-nav class='fixed inset-x-0 top-grid-margin z-50 mix-blend-difference text-white'>
    <Container>
        <Grid>
            <div class='col-span-4 flex flex-col items-start gap-1'>
                <a href='/' class='text-label uppercase transition-opacity hover:opacity-50'>Benjamin Wagner</a>
                <p class='text-label uppercase opacity-50'>developer + designer</p>
            </div>
            <div class='col-span-4'></div>
            <div class='col-span-4 flex flex-col items-end gap-1 text-right'>
                {
                    links.map((link) => (
                        <a href={link.href} class='text-label uppercase transition-opacity hover:opacity-50'>
                            {link.label}
                        </a>
                    ))
                }
            </div>
        </Grid>
    </Container>
</nav>
