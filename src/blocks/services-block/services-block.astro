---
import { Container, Grid, Section } from "@/components/core";

interface IService {
    title: string;
    note: string;
    /** Weeks of work, used to add up the scope estimate. */
    weeks: [number, number] | null;
    /** Shown instead of a week count for open-ended work. */
    basis?: string;
}

const services: IService[] = [
    { title: "Design", note: "Layout, type and motion, drawn in the browser", weeks: [2, 4] },
    { title: "Development", note: "Astro, React or plain TypeScript", weeks: [3, 8] },
    { title: "Sanity CMS", note: "Fields your editors understand", weeks: [1, 2] },
    { title: "SEO / GEO", note: "Structured data for search and for AI answers", weeks: [1, 2] },
    { title: "Maintenance", note: "Updates and small changes, monthly", weeks: null, basis: "Retainer" },
];
---

<Section theme='dark' data-services-block>
    <Container>
        <Grid class='pb-column-1'>
            <p class='col-span-6 text-caption uppercase opacity-50'>Services</p>
            <p class='col-span-6 text-caption uppercase text-right opacity-50'>Pick what you need</p>
        </Grid>

        <ul>
            {
                services.map((service, index) => (
                    <li>
                        <button
                            type='button'
                            aria-pressed='false'
                            data-service={service.title}
                            data-min={service.weeks?.[0] ?? 0}
                            data-max={service.weeks?.[1] ?? 0}
                            data-basis={service.basis}
                            class='service-row group w-full border-t border-foreground/15 py-4 text-left'
                        >
                            <span class='layout-inner-grid items-baseline'>
                                <span class='col-span-1 text-caption uppercase opacity-50'>[0{index + 1}]</span>
                                <span class='col-span-7 text-headline uppercase'>{service.title}</span>
                                <span class='col-span-3 text-label uppercase opacity-50'>{service.note}</span>
                                <span class='service-mark col-span-1 text-headline text-right'>+</span>
                            </span>
                        </button>
                    </li>
                ))
            }
        </ul>

        <Grid class='sticky bottom-grid-margin mt-column-1 border-t border-foreground/15 pt-4'>
            <p class='col-span-1 text-caption uppercase opacity-50'>Scope</p>
            <p data-services-scope class='col-span-7 text-label uppercase'>Nothing picked yet</p>
            <p data-services-estimate class='col-span-2 text-label uppercase opacity-50'>&mdash;</p>
            <a
                data-services-brief
                href='/contact'
                class='col-span-2 text-label uppercase text-right transition-opacity hover:opacity-50'
            >
                Send the brief
            </a>
        </Grid>
    </Container>
</Section>
