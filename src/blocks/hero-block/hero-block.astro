---
import { Image } from "astro:assets";
import { Container, Grid, ProgressiveBlurText, Section } from "@/components/core";

import HomeHero from "@/assets/images/home-hero.jpg";
---

<Section class='h-[200svh] py-0! overflow-clip' theme='dark' data-hero-block>
    <Image
        src={HomeHero}
        alt='Benjamin Wagner, black and white film portrait'
        widths={[640, 1080, 1600, 2200, 2800, 3456]}
        sizes='100vw'
        quality={80}
        loading='eager'
        fetchpriority='high'
        data-scroll
        data-scroll-speed='-0.15'
        class='absolute inset-0 h-full w-full object-cover'
    />
    <ProgressiveBlurText text='DES + DEV' to='top' class='text-display text-foreground-muted absolute inset-x-0 top-0 max-lg:top-28 text-center' />
    <div class='absolute inset-0 z-10' aria-hidden='true'></div>

    <div class='absolute inset-x-grid-margin bottom-[50svh] z-10 h-[46svh] translate-y-1/2'>
        <canvas data-hero-gap class='block h-full w-full' aria-hidden='true'></canvas>
        <p class='text-label absolute inset-0 grid place-items-center text-center uppercase'>Closing the gap™</p>
    </div>

    <Container class='relative z-20 top-[calc((18.151vw/100*78)/2)] -translate-y-1/2 max-lg:top-[calc(7rem+14.16vw+1.5rem)] max-lg:translate-y-0'>
        <Grid class='h-full'>
            <div class='col-span-4 max-lg:hidden'></div>
            <div class='col-span-4 max-lg:col-span-12 self-center flex flex-col justify-center items-center gap-1 text-center'>
                <h1 class='text-label uppercase'>
                    The gap between designer and developer <br /> is where sites die. I closed it.
                </h1>
            </div>
            <div class='col-span-4 max-lg:hidden'></div>
        </Grid>
    </Container>
    <Container class='absolute z-20 bottom-grid-margin inset-x-0'>
        <Grid class='h-full max-lg:gap-y-8'>
            <div class='col-span-4 max-lg:col-span-12 grid grid-cols-4 gap-grid-gutter'>
                <p class='col-span-2 text-label uppercase'>Services</p>
                <ul class='col-span-2 text-label uppercase space-y-2'>
                    <li>Design</li>
                    <li>Development</li>
                    <li>Sanity CMS</li>
                    <li>SEO / GEO</li>
                    <li>Maintenance</li>
                </ul>
            </div>
            <div class='col-span-4 max-lg:hidden'></div>
            <div class='col-span-4 max-lg:col-span-12 grid grid-cols-4 gap-grid-gutter'>
                <p class='col-span-2 text-label uppercase'>Based in Austria</p>
                <div class='col-span-2 flex flex-col gap-1'>
                    <p class='text-label uppercase'>Upper Austria, <br />working everywhere</p>
                    <p data-local-time class='text-label uppercase opacity-50'>--:--:--</p>
                </div>
            </div>
        </Grid>
    </Container>
</Section>
