---
import { Image } from "astro:assets";
import { ProgressiveBlurText, Section } from "@/components/core";

import AlterEgo from "@/assets/images/ae.jpg";
import ClaudiaReiterer from "@/assets/images/claudiareiterer.jpg";
import HardChor from "@/assets/images/hard-chor.jpg";

interface IProject {
    title: string;
    image: ImageMetadata;
    year: string;
    discipline: string;
    /** Section-relative start offset in svh. */
    top: number;
    /** Tailwind column placement for the card. */
    placement: string;
    /** Locomotive parallax speed. Higher = flies past faster. */
    speed: number;
}

const projects: IProject[] = [
    { title: "Hard-Chor", image: HardChor, year: "2025", discipline: "Design + Build", top: 110, placement: "ml-column-1 w-column-6 max-lg:ml-0 max-lg:w-full", speed: 0.45 },
    { title: "Alter Ego Festival", image: AlterEgo, year: "2025", discipline: "Design + Build", top: 180, placement: "ml-auto mr-column-1 w-column-6 max-lg:mr-0 max-lg:w-full", speed: 0.3 },
    { title: "Claudia Reiterer", image: ClaudiaReiterer, year: "2026", discipline: "Design + Build", top: 250, placement: "ml-column-3 w-column-6 max-lg:ml-0 max-lg:w-full", speed: 1 },
];
---

<Section id='work' theme='light' class='h-[460svh] -mt-[100svh] py-0! z-0! overflow-clip' data-work-block>
    <div class='sticky top-0 h-svh flex items-center justify-center'>
        <div data-work-title class='relative w-full'>
            <ProgressiveBlurText as='h2' text='Archive' to='top' class='relative text-foreground-muted text-center text-display uppercase' />
            <span class='text-label uppercase absolute inset-0 grid place-items-center'>2021 — 2026</span>
        </div>
    </div>

    <div class='absolute inset-y-0 inset-x-grid-margin z-10'>
        {
            projects.map((project) => (
                <article class:list={["absolute inset-x-0", project.placement]} style={`top: ${project.top}svh`} data-scroll data-scroll-speed={project.speed}>
                    <div class='relative w-full overflow-clip'>
                        <Image src={project.image} alt={`${project.title} website, ${project.year}`} widths={[480, 800, 1200, 1680]} sizes='(min-width: 1024px) 50vw, 100vw' quality={80} class='h-auto w-full' />
                        <div class='absolute inset-x-0 bottom-[6%] flex flex-col items-center gap-2 text-center text-white'>
                            <p class='text-label uppercase'>{project.year}</p>
                            <p class='text-title uppercase'>{project.title}</p>
                            <p class='text-caption uppercase opacity-80'>{project.discipline}</p>
                        </div>
                    </div>
                </article>
            ))
        }
    </div>
</Section>
