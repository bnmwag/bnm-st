---
import { Image } from "astro:assets";
import Retainer from "@/assets/images/retainer.jpg";
import { Button, Container, Grid, Section } from "@/components/core";

import RetainerImage from "@/assets/images/retainer.jpg";

interface IEntry {
    value: string;
    note?: string;
}

interface IRow {
    label: string;
    entries: IEntry[];
}

interface ITier {
    kind: string;
    title: string;
    rows: IRow[];
    action: string;
    href: string;
    /** Renders the card on the dark theme, over the retainer photograph. */
    dark?: boolean;
}

const tiers: ITier[] = [
    {
        kind: "Project",
        title: "The site",
        rows: [
            { label: "Summary", entries: [{ value: "Design and build by one person, from the first sketch to launch." }] },
            {
                label: "Pricing",
                entries: [
                    { value: "Up to six pages", note: "from 5k€" },
                    { value: "Anything bigger, custom, CMS", note: "from 10k€" },
                ],
            },
            { label: "Includes", entries: [{ value: "Concept, design, code, launch, 30 days of fixes" }] },
        ],
        action: "Start a project",
        href: "/contact?tier=project",
    },
    {
        kind: "Monthly",
        title: "The retainer",
        rows: [
            { label: "Summary", entries: [{ value: "Your designer and developer, without the hire." }] },
            { label: "Pricing", entries: [{ value: "Per month", note: "2k€" }] },
            { label: "Terms", entries: [{ value: "One active request. 48-hour turnaround. Pause or cancel anytime." }] },
            { label: "For", entries: [{ value: "Agencies with overflow, companies that need someone on call" }] },
        ],
        action: "Book a month",
        href: "/contact?tier=retainer",
        dark: true,
    },
];
---

<Section theme='light' data-rates-block>
    <Container>
        <Grid>
            <div class='col-span-6 sticky top-header-height self-start'>
                <h2 class='text-[max(3rem,9vw)] text-foreground-muted font-semibold leading-[78%] tracking-[-3%] uppercase'>Rates</h2>
                <p class='text-label uppercase pt-8'>Two ways to work with me.</p>
                <p class='text-caption uppercase opacity-50 pt-2'>Anything that fits neither, write to me and we work it out.</p>
            </div>

            <div class='col-span-4 col-start-8 flex flex-col gap-grid-gutter'>
                {
                    tiers.map((tier, index) => (
                        <article class:list={["relative flex min-h-[70svh] flex-col overflow-clip", tier.dark ? "theme-dark" : "bg-white/70"]}>
                            {tier.dark && <Image src={RetainerImage} alt='' class='absolute inset-0 z-0 h-full w-full object-cover' />}

                            <header class='relative z-10 flex items-start justify-between p-grid-margin'>
                                <div class='space-y-2'>
                                    <p class='text-label uppercase opacity-50'>{tier.kind}</p>
                                    <h3 class='text-[max(1rem,1.75vw)] font-semibold leading-[86%] tracking-[-3%] uppercase'>{tier.title}</h3>
                                </div>
                                <p class='text-[max(3rem,8.75vw)] leading-[72%] tracking-[-3%]'>0{index + 1}</p>
                            </header>

                            <dl class='relative z-10 mt-32 mb-16 px-grid-margin'>
                                {tier.rows.map((row) => (
                                    <div class='grid grid-cols-12 gap-x-grid-gutter border-t border-foreground/15 pt-4 pb-8'>
                                        <dt class='col-span-5 text-caption uppercase opacity-50'>{row.label}</dt>
                                        <dd class='col-span-7 space-y-4 text-title'>
                                            {row.entries.map((entry) => (
                                                <div class='space-y-1'>
                                                    <p>{entry.value}</p>
                                                    {entry.note && <span class='block opacity-50'>{entry.note}</span>}
                                                </div>
                                            ))}
                                        </dd>
                                    </div>
                                ))}
                            </dl>

                            <Button href={tier.href} label={tier.action} class='z-10 mt-auto m-grid-margin' />
                        </article>
                    ))
                }
            </div>
        </Grid>
    </Container>
</Section>
